pipeline {
    agent any

    environment {
        AWS_CREDS = credentials('aws-creds')   // Jenkins AWS credentials ID
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'Terraform-ec2-template',
                    url: 'https://github.com/kishanadlakha/terraform-zero-to-hero.git'
            }
        }

        stage('Terraform Init') {
            steps {
                sh '''
                  terraform init \
                    -backend-config="access_key=$AWS_CREDS_USR" \
                    -backend-config="secret_key=$AWS_CREDS_PSW"
                '''
            }
        }

        stage('Terraform Plan') {
            steps {
                sh '''
                  terraform plan -out=tfplan \
                    -var-file=terraform.tfvars
                '''
                sh 'terraform show -no-color tfplan > tfplan.txt'
                archiveArtifacts artifacts: 'tfplan.txt', fingerprint: true
            }
        }

        stage('Approval') {
            steps {
                input message: "Do you want to apply this Terraform plan?", ok: "Apply"
            }
        }

        stage('Terraform Apply') {
            steps {
                sh 'terraform apply -auto-approve tfplan'
            }
        }

        stage('Show Outputs') {
            steps {
                sh 'terraform output'
            }
        }
    }
}

